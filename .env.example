# ============================================================
# Sefako AI Studio - Variables d'environnement Docker
# Copie ce fichier en .env avant le déploiement
# ============================================================

# --- Base de données ---
POSTGRES_USER=aia_user
POSTGRES_PASSWORD=aia_password
POSTGRES_DB=aia_db
DATABASE_URL=postgresql+asyncpg://aia_user:aia_password@db:5432/aia_db

# --- Sécurité ---
SECRET_KEY=change-this-secret-key-with-a-random-64-char-string
ENCRYPTION_KEY=

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Compte admin initial ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=geonidas

# --- API Keys LLM (optionnelles) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
BEDROCK_REGION=

# --- Code Server / IDE ---
IDE_DOMAIN=ide.it-sefako.com
IDE_PUBLIC_URL=https://ide.it-sefako.com
CODE_SERVER_PASSWORD=geonidas

# --- Frontend / API ---
BACKEND_URL=http://backend:8000
CORS_ORIGINS=["http://localhost:3000","https://sefako-ai-studio.it-sefako.com"]
FRONTEND_DOMAIN=sefako-ai-studio.it-sefako.com
API_DOMAIN=api-sefako-ai-studio.it-sefako.com

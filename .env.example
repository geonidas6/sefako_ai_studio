# ============================================================
# Sefako AI Studio - Variables d'environnement Docker
# Copie ce fichier en .env avant le déploiement
# ============================================================

# --- Base de données ---
POSTGRES_USER=aia_user
POSTGRES_PASSWORD=aia_password
POSTGRES_DB=aia_db
DATABASE_URL=postgresql+asyncpg://aia_user:aia_password@db:5432/aia_db

# --- Sécurité ---
SECRET_KEY=change-this-secret-key-with-a-random-64-char-string
ENCRYPTION_KEY=

# --- Compte admin initial ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@AIA2026!

# --- API Keys LLM (optionnelles) ---
GEMINI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# --- OpenHands local / public ---
OPENHANDS_INTERNAL_URL=http://openhands:8000
OPENHANDS_AGENT_SERVER_URL=http://openhands:18000
OPENHANDS_BASE_URL=/openhands
OPENHANDS_PUBLIC_URL=https://open-hand-sefako-ai-studio.it-sefako.com

# --- Frontend / API ---
BACKEND_URL=http://backend:8000
CORS_ORIGINS=["http://localhost:3000","https://sefako-ai-studio.it-sefako.com"]
FRONTEND_DOMAIN=sefako-ai-studio.it-sefako.com
API_DOMAIN=api-sefako-ai-studio.it-sefako.com

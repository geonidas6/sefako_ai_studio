# ============================================================
# AIA Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://aia_user:aia_password@localhost:5432/aia_db

# --- Sécurité (JWT) ---
# Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-with-a-random-64-char-string

# --- Compte Admin par défaut (créé au premier démarrage) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@AIA2026!

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Clé de chiffrement des clés API LLM en base ---
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Clés API LLM (laisser vide pour utiliser le mode mock) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
QWEN_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
BEDROCK_REGION=

# --- CORS ---
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# --- App ---
DEBUG=false
